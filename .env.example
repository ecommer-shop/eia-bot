# ─── IA / RAG ──────────────────────────────────────────────────────────
# URL COMPLETA del endpoint, incluido /chat: el servicio hace POST directo
# aqui y no agrega la ruta. Contrato: envia {"query": "..."} y devuelve
# {"answer": "..."}.
SIMETRIA_API_URL=https://simetria.ecommer.shop/chat
# Opcional. Si se define, se envia como Authorization: Bearer <valor>
SIMETRIA_API_KEY=

# ─── Chatwoot ──────────────────────────────────────────────────────────
CHATWOOT_BASE_URL=https://chat.ecommer.shop
CHATWOOT_ACCOUNT_ID=1
# Token de acceso de un agente con permiso sobre la cuenta y las bandejas
CHATWOOT_API_ACCESS_TOKEN=
# Opcional: solo se atienden estas bandejas, separadas por coma. Vacio = todas
CHATWOOT_ALLOWED_INBOX_IDS=

# ─── Azure AI Foundry (Phi-4) ──────────────────────────────────────────
# Red de seguridad: se usa si el RAG falla o responde su mensaje de aviso
# tecnico (el RAG devuelve HTTP 200 incluso cuando su LLM fallo). Sin estas
# variables el bot sigue funcionando, solo sin respaldo.
AZURE_AI_ENDPOINT=https://tu-recurso.services.ai.azure.com/openai/v1/
AZURE_AI_KEY=
AZURE_AI_DEPLOYMENT=Phi-4

# ─── Memoria (Valkey / Redis) ──────────────────────────────────────────
# Sin esto el bot funciona, pero sin memoria de conversacion ni
# deduplicacion de reintentos de Chatwoot
VALKEY_URL=redis://usuario:password@host:puerto

# ─── Operacion ─────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Chatwoot corta el webhook a los 5s, pero el trabajo corre en segundo
# plano: estos timeouts no afectan el tiempo de respuesta del webhook.
# El RAG usa un modelo con razonamiento: medido en vivo entre 6s y 30s.
AI_TIMEOUT_SECONDS=40
CHATWOOT_TIMEOUT_SECONDS=15
# Ventana para descartar entregas repetidas del mismo mensaje
DEDUP_TTL_SECONDS=3600
